# ==============================================================================
# CareerOrbit .NET 10 API - Multi-Stage Production Dockerfile
# ==============================================================================

# Stage 1: Build & Publish
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files for layer caching
COPY ["JobPortal.slnx", "./"]
COPY ["src/JobPortal.Domain/JobPortal.Domain.csproj", "src/JobPortal.Domain/"]
COPY ["src/JobPortal.Application/JobPortal.Application.csproj", "src/JobPortal.Application/"]
COPY ["src/JobPortal.Infrastructure/JobPortal.Infrastructure.csproj", "src/JobPortal.Infrastructure/"]
COPY ["src/JobPortal.Api/JobPortal.Api.csproj", "src/JobPortal.Api/"]
COPY ["tests/JobPortal.Domain.UnitTests/JobPortal.Domain.UnitTests.csproj", "tests/JobPortal.Domain.UnitTests/"]
COPY ["tests/JobPortal.Application.UnitTests/JobPortal.Application.UnitTests.csproj", "tests/JobPortal.Application.UnitTests/"]

# Restore dependencies
RUN dotnet restore JobPortal.slnx

# Copy complete source code
COPY . .

# Build and publish API in Release mode
WORKDIR "/src/src/JobPortal.Api"
RUN dotnet publish "JobPortal.Api.csproj" \
    -c Release \
    -o /app/publish \
    /p:UseAppHost=false

# Stage 2: Production Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Install curl for container health checks
RUN apk add --no-cache curl icu-libs

# Configure environment variables
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Create upload directory and non-root app user
RUN mkdir -p /app/uploads/resumes && \
    addgroup -g 1000 -S appgroup && \
    adduser -u 1000 -S appuser -G appgroup && \
    chown -R appuser:appgroup /app

# Copy published artifacts from build stage
COPY --from=build --chown=appuser:appgroup /app/publish .

# Run under secure non-root user
USER appuser

EXPOSE 8080

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/scalar/v1 || exit 1

ENTRYPOINT ["dotnet", "JobPortal.Api.dll"]
