# ==============================================================================
# CareerOrbit / JobPortal Environment Configuration Example
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# PostgreSQL Relational Database Configuration
POSTGRES_DB=jobportal_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# ASP.NET Core API Configuration
ASPNETCORE_ENVIRONMENT=Production

# JWT Authentication Settings
# NOTE: Secret must be at least 32 characters (256 bits) long
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_2026!
JWT_ISSUER=JobPortalApi
JWT_AUDIENCE=JobPortalClient
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
